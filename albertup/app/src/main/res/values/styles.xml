<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text -->
    <style name="Widget.AlberTUP.Text" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/body_text_size</item>
    </style>

    <style name="Widget.AlberTUP.Text.Title">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.AlberTUP.Text.SectionTitle">
        <item name="android:textSize">@dimen/section_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Widget.AlberTUP.Text.BodyLarge">
        <item name="android:textSize">@dimen/body_large_text_size</item>
    </style>

    <style name="Widget.AlberTUP.Text.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.AlberTUP.Text.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/caption_text_size</item>
    </style>

    <style name="Widget.AlberTUP.Text.StatNumber">
        <item name="android:textSize">@dimen/stat_number_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cards -->
    <style name="Widget.AlberTUP.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.AlberTUP.Card.Accent">
        <item name="cardBackgroundColor">@color/accent_container</item>
        <item name="strokeWidth">@dimen/spacing_none</item>
    </style>

    <style name="Widget.AlberTUP.Card.Selectable">
        <item name="strokeColor">@color/selector_card_stroke</item>
        <item name="checkedIcon">@drawable/ic_check_circle</item>
        <item name="checkedIconTint">@color/accent_volt</item>
        <item name="checkedIconSize">@dimen/icon_size_small</item>
        <item name="checkedIconMargin">@dimen/spacing_small</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.AlberTUP.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/button_text_size</item>
    </style>

    <style name="Widget.AlberTUP.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.AlberTUP.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.AlberTUP.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.AlberTUP.Button.Icon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.AlberTUP.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>
</resources>
