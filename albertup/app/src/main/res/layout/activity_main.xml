<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_clearance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:id="@+id/columnMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:contentDescription="@string/desc_logo"
                    android:src="@drawable/ic_brand_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        style="@style/Widget.AlberTUP.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_albertup" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/Widget.AlberTUP.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Martes, 17 de noviembre" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnHistory"
                    style="@style/Widget.AlberTUP.Button.IconPlain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/history_title"
                    app:icon="@drawable/ic_history"
                    app:iconTint="@color/text_primary" />

                <Button
                    android:id="@+id/btnSettings"
                    style="@style/Widget.AlberTUP.Button.IconPlain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_title"
                    app:icon="@drawable/ic_settings"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvStreak"
                style="@style/Widget.AlberTUP.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_pill"
                android:drawablePadding="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:minHeight="@dimen/stepper_button_size"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_large"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_flame"
                app:drawableTint="@color/accent_volt"
                tools:text="Racha de 3 días" />

            <!-- Today -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardToday"
                style="@style/Widget.AlberTUP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.AlberTUP.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_title" />

                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTodayRepsValue"
                                style="@style/Widget.AlberTUP.Text.StatNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="45" />

                            <TextView
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_reps_label" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTodaySetsValue"
                                style="@style/Widget.AlberTUP.Text.StatNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="3" />

                            <TextView
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_sets_label" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvGoalPercent"
                                style="@style/Widget.AlberTUP.Text.StatNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="45 %" />

                            <TextView
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_goal_label" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressDaily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:max="100"
                        app:indicatorColor="@color/accent_volt"
                        app:trackColor="@color/divider"
                        app:trackCornerRadius="@dimen/progress_corner"
                        app:trackThickness="@dimen/progress_height" />

                    <TextView
                        android:id="@+id/tvDailyGoal"
                        style="@style/Widget.AlberTUP.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        tools:text="45 de 100 reps" />

                    <TextView
                        android:id="@+id/tvMotivation"
                        style="@style/Widget.AlberTUP.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xsmall"
                        android:accessibilityLiveRegion="polite"
                        android:textStyle="bold"
                        tools:text="¡Faltan 55 reps para tu meta! Seguí así." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Exercises -->
            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/section_exercises" />

            <LinearLayout
                android:id="@+id/exerciseCardsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPushUp"
                    style="@style/Widget.AlberTUP.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    app:contentPadding="@dimen/spacing_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/card_illustration_height"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/illus_push_up" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pushups"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPushUpStats"
                            style="@style/Widget.AlberTUP.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Hoy: 30 · Récord: 25" />

                        <Button
                            android:id="@+id/btnLogPushUp"
                            style="@style/Widget.AlberTUP.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/action_log"
                            app:icon="@drawable/ic_add" />

                        <Button
                            android:id="@+id/btnGuidePushUp"
                            style="@style/Widget.AlberTUP.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view_guide"
                            app:icon="@drawable/ic_menu_book" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPullUp"
                    style="@style/Widget.AlberTUP.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:contentPadding="@dimen/spacing_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/card_illustration_height"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/illus_pull_up" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pullups"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPullUpStats"
                            style="@style/Widget.AlberTUP.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Hoy: 12 · Récord: 10" />

                        <Button
                            android:id="@+id/btnLogPullUp"
                            style="@style/Widget.AlberTUP.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/action_log"
                            app:icon="@drawable/ic_add" />

                        <Button
                            android:id="@+id/btnGuidePullUp"
                            style="@style/Widget.AlberTUP.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_view_guide"
                            app:icon="@drawable/ic_menu_book" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Today's sets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTodaysSetsTitle"
                    style="@style/Widget.AlberTUP.Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Series de hoy (3)" />

                <Button
                    android:id="@+id/btnViewHistory"
                    style="@style/Widget.AlberTUP.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_history" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/empty_image_size"
                    android:layout_height="@dimen/empty_image_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_empty_sets" />

                <TextView
                    style="@style/Widget.AlberTUP.Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_weight="1"
                    android:text="@string/today_empty" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/setsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Records -->
            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/pr_title" />

            <LinearLayout
                android:id="@+id/prRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AlberTUP.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trophy"
                            app:tint="@color/accent_volt" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pr_pushups_label" />

                        <TextView
                            android:id="@+id/tvPrPushValue"
                            style="@style/Widget.AlberTUP.Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            tools:text="25 reps" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AlberTUP.Card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_small"
                            android:layout_height="@dimen/icon_size_small"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trophy"
                            app:tint="@color/accent_volt" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/pr_pullups_label" />

                        <TextView
                            android:id="@+id/tvPrPullValue"
                            style="@style/Widget.AlberTUP.Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            tools:text="12 reps" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AlberTUP.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.AlberTUP.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pr_total_label" />

                    <TextView
                        android:id="@+id/tvPrTotalValue"
                        style="@style/Widget.AlberTUP.Text.StatNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1.240 reps" />

                    <TextView
                        android:id="@+id/tvPrTotalSets"
                        style="@style/Widget.AlberTUP.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="en 64 series" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvLocalDataNote"
                style="@style/Widget.AlberTUP.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:gravity="center"
                android:text="@string/local_data_note" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabLog"
        style="@style/Widget.AlberTUP.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_large"
        android:text="@string/action_log_set"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
