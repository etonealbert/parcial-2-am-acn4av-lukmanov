<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ExerciseGuideActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AlberTUP.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        tools:title="@string/pushups" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AlberTUP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="@dimen/spacing_none">

                <ImageView
                    android:id="@+id/ivHero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/illustration_height"
                    android:contentDescription="@string/guide_illustration_desc"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/illus_push_up" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSummary"
                style="@style/Widget.AlberTUP.Text.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                tools:text="@string/guide_push_up_summary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOnline"
                style="@style/Widget.AlberTUP.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:contentPadding="@dimen/spacing_none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivOnlinePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/remote_image_height"
                        android:background="@color/surface_container"
                        android:contentDescription="@string/online_photo_desc"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:src="@drawable/illus_pull_up"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Widget.AlberTUP.Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/spacing_small"
                            android:gravity="center_vertical"
                            android:text="@string/online_title"
                            app:drawableStartCompat="@drawable/ic_language"
                            app:drawableTint="@color/accent_volt" />

                        <LinearLayout
                            android:id="@+id/onlineLoading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                app:indicatorColor="@color/accent_volt"
                                app:indicatorSize="@dimen/icon_size_small" />

                            <TextView
                                style="@style/Widget.AlberTUP.Text.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:layout_weight="1"
                                android:accessibilityLiveRegion="polite"
                                android:text="@string/online_loading" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/onlineContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvOnlineStatus"
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:drawablePadding="@dimen/spacing_small"
                                android:gravity="center_vertical"
                                android:visibility="gone"
                                app:drawableStartCompat="@drawable/ic_cloud_off"
                                app:drawableTint="@color/text_secondary"
                                tools:text="Sin conexión: mostrando la copia guardada."
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tvOnlineExtract"
                                style="@style/Widget.AlberTUP.Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                tools:text="Se denomina dominada o pull-up a un ejercicio de fuerza..." />

                            <TextView
                                android:id="@+id/tvTextCredit"
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_medium"
                                tools:text="Texto: «Dominada», colaboradores de Wikipedia, CC BY-SA 4.0 (extracto)." />

                            <TextView
                                android:id="@+id/tvPhotoCredit"
                                style="@style/Widget.AlberTUP.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xsmall"
                                android:visibility="gone"
                                tools:text="Foto: Cpl. C.J. Yard · Public domain, vía Wikimedia Commons."
                                tools:visibility="visible" />

                            <Button
                                android:id="@+id/btnOpenArticle"
                                style="@style/Widget.AlberTUP.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xsmall"
                                android:text="@string/action_read_article"
                                app:icon="@drawable/ic_open_in_new" />

                            <Button
                                android:id="@+id/btnOpenPhotoLicense"
                                style="@style/Widget.AlberTUP.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_photo_license"
                                android:visibility="gone"
                                app:icon="@drawable/ic_open_in_new"
                                tools:visibility="visible" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/onlineError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvOnlineError"
                                style="@style/Widget.AlberTUP.Text.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:drawablePadding="@dimen/spacing_small"
                                android:gravity="center_vertical"
                                app:drawableStartCompat="@drawable/ic_cloud_off"
                                app:drawableTint="@color/text_secondary"
                                tools:text="Sin conexión. Revisá tu red y volvé a intentar." />

                            <Button
                                android:id="@+id/btnRetry"
                                style="@style/Widget.AlberTUP.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:text="@string/action_retry"
                                app:icon="@drawable/ic_refresh" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/guide_section_stats" />

            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatRecord"
                        style="@style/Widget.AlberTUP.Text.StatNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="25" />

                    <TextView
                        style="@style/Widget.AlberTUP.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_stat_record" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatTotal"
                        style="@style/Widget.AlberTUP.Text.StatNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1.240" />

                    <TextView
                        style="@style/Widget.AlberTUP.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_stat_total" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatSets"
                        style="@style/Widget.AlberTUP.Text.StatNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="64" />

                    <TextView
                        style="@style/Widget.AlberTUP.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_stat_sets" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnHistory"
                style="@style/Widget.AlberTUP.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/guide_history_button"
                app:icon="@drawable/ic_history" />

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/guide_section_muscles" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMuscles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small" />

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/guide_section_steps" />

            <LinearLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/guide_section_mistakes" />

            <LinearLayout
                android:id="@+id/mistakesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/guide_section_progressions" />

            <TextView
                style="@style/Widget.AlberTUP.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:text="@string/guide_progressions_hint" />

            <LinearLayout
                android:id="@+id/progressionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AlberTUP.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_primary" />

                    <TextView
                        style="@style/Widget.AlberTUP.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        android:text="@string/guide_safety" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <Button
            android:id="@+id/btnLog"
            style="@style/Widget.AlberTUP.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guide_log_button"
            app:icon="@drawable/ic_add" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
