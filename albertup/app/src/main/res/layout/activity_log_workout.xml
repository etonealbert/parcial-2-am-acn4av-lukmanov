<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".LogWorkoutActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AlberTUP.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/log_title_new" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_question_exercise" />

            <LinearLayout
                android:id="@+id/exerciseRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPushUp"
                    style="@style/Widget.AlberTUP.Card.Selectable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/card_illustration_height"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/illus_push_up" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:gravity="center"
                            android:text="@string/pushups"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPushUpRecord"
                            style="@style/Widget.AlberTUP.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="Récord: 25" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPullUp"
                    style="@style/Widget.AlberTUP.Card.Selectable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/card_illustration_height"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/illus_pull_up" />

                        <TextView
                            style="@style/Widget.AlberTUP.Text.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:gravity="center"
                            android:text="@string/pullups"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPullUpRecord"
                            style="@style/Widget.AlberTUP.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            tools:text="Sin récord aún" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                style="@style/Widget.AlberTUP.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/log_reps_title" />

            <LinearLayout
                android:id="@+id/stepperRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Widget.AlberTUP.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/decrease_desc"
                    app:icon="@drawable/ic_minus" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReps"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:hint="@string/log_reps_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="@dimen/rep_input_text_size"
                        android:textStyle="bold"
                        tools:text="12" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Widget.AlberTUP.Button.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/increase_desc"
                    app:icon="@drawable/ic_plus" />

            </LinearLayout>

            <TextView
                style="@style/Widget.AlberTUP.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/log_quick_picks" />

            <LinearLayout
                android:id="@+id/quickPickRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuick1"
                    style="@style/Widget.AlberTUP.Button.QuickPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    tools:text="5" />

                <Button
                    android:id="@+id/btnQuick2"
                    style="@style/Widget.AlberTUP.Button.QuickPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    tools:text="10" />

                <Button
                    android:id="@+id/btnQuick3"
                    style="@style/Widget.AlberTUP.Button.QuickPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    tools:text="15" />

                <Button
                    android:id="@+id/btnQuick4"
                    style="@style/Widget.AlberTUP.Button.QuickPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="20" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AlberTUP.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:layout_marginEnd="@dimen/spacing_medium"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvRecordHint"
                        style="@style/Widget.AlberTUP.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        tools:text="Tu mejor serie: 25 flexiones." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvEditInfo"
                style="@style/Widget.AlberTUP.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:visibility="gone"
                tools:text="Registrada: Martes, 17 de noviembre · 08:12. Al editar se conserva la fecha original."
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.AlberTUP.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_save_generic"
            app:icon="@drawable/ic_check" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.AlberTUP.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_delete"
            android:textColor="@color/error"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/error"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
